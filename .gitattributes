# Preserve generated distribution bytes in Code > Download ZIP.
GAME-PORTAL.html binary linguist-generated=true
GAME-PORTAL-WINDOWS.exe binary linguist-generated=true
GAME-PORTAL.exe binary linguist-generated=true
DESKTOP-LICENSES.txt -text -whitespace
GAME-PORTAL-MAC binary linguist-generated=true
GAME-PORTAL-MAC.command text eol=lf
GAME-PORTAL-MOJAVE binary linguist-generated=true
GAME-PORTAL-MOJAVE.command text eol=lf
GAME-PORTAL-MOJAVE.app/** binary linguist-generated=true
README-WINDOWS.txt -text
THIRD-PARTY-LICENSES.txt -text

GAME-PORTAL-PLAY.html binary
GAME-PORTAL-PLAY.exe binary
GAME-PORTAL-PLAY-MOJAVE.app/** binary
GAME-PORTAL-MAC.app/** binary
GAME-PORTAL-PLAY-MAC.app/** binary

# Public platform / role distribution keeps executable/signature bytes exact.
Windows/** binary linguist-generated=true
Mac/** binary linguist-generated=true
HTML/** binary linguist-generated=true
HTML/**/*.command text eol=lf
HTML/**/*.cmd -text
# Code > Download ZIP is for players and creators. Sources remain in Git.
/.github export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/assets export-ignore
/desktop export-ignore
/offline-html export-ignore
/scripts export-ignore
/tests export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/docs/DEVELOPMENT.md export-ignore
